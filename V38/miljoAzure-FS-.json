{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.3",
  "metadata": {
    "note": " Detta schema är för att skapa resurser utöver resursgrupper. och skapar allting innuti resursgruppen"
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "novatrix-test",
      "metadata": { "description": "Prefix for alla resursnamn, sa att allt hanger ihop." }
    },
    "location": {
      "type": "string",
      "defaultValue": "swedencentral",
      "metadata": { "description": "Region for resurserna." }
    }
  },
  "variables": {
    "storageName": "[concat('st', parameters('namePrefix'), uniqueString(resourceGroup().id))]",
    "vnetName": "[concat('vnet-', parameters('namePrefix'))]",
    "nsgName" : "[concat('nsg-', parameters('namePrefix'))]",
    "rgName" : "[concat('rg-', parameters('namePrefix'))]"
    
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-07-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-web",
            "properties": {
              "priority": 1001,
              "protocol": "Tcp",
              "direction": "Inbound",
              "access": "Allow",
              "sourceAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRanges": [
                  "80",
                  "443"
                ]
            }
          },
          {
            "name": "Allow-my-SSH",
            "properties": {
              "priority": 1002,
              "protocol": "Tcp",
              "direction": "Inbound",
              "access": "Allow",
              "sourceAddressPrefix": "83.251.180.30/32",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22"
            }
          }
        ]
      }
    }
  ],
  "outputs": {
  } 
}