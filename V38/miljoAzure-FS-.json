{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.2.1",
  "metadata": {
    "note": " Detta schema är för att skapa resurser utöver resursgrupper. och skapar allting innuti resursgruppen"
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "novatrix-test",
      "metadata": { "description": "Prefix for alla resursnamn, sa att allt hanger ihop." }
    },
    "location": {
      "type": "string",
      "defaultValue": "swedencentral",
      "metadata": { "description": "Region for resurserna." }
    }
  },
  "variables": {
    "storageName": "[concat('st', parameters('namePrefix'), uniqueString(resourceGroup().id))]",
    "vnetName": "[concat('vnet-', parameters('namePrefix'))]",
    "nsgName" : "[concat('nsg-', parameters('namePrefix'))]",
    "rgName" : "[concat('rg-', parameters('namePrefix'))]"
    
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-07-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "allow-web",
            "properties": {
              "priority": 1001,
              "protocol": "Tcp",
              "direction": "Inbound",
              "access": "Allow",
              "sourceAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRanges": [
                  "80",
                  "443"
                ]
            }
          },
          {
            "name": "Allow-my-SSH",
            "properties": {
              "priority": 1002,
              "protocol": "Tcp",
              "direction": "Inbound",
              "access": "Allow",
              "sourceAddressPrefix": "83.251.180.30/32",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-07-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "[concat('snet-', parameters('namePrefix'))]",
            "properties": {
              "addressPrefix": "10.0.1.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.network/networkInterfaces",
      "apiVersion": "2024-07-01",
      "name": "[concat('nic-', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), concat('snet-', parameters('namePrefix')))]"
              },
              "privateIPAllocationMethod": "Dynamic"
            }
          }
        ]
      } 
    }
  ],
  "outputs": {
  } 
}